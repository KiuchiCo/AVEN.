{
  "name": "@aven/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "AVEN. for iPhone and iPad: the web app in a native shell (Capacitor).",
  "scripts": {
    "sync": "cap sync ios",
    "build:ios": "node scripts/build-ios.mjs development",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "sync:staging": "AVEN_ENV=staging cap sync ios",
    "sync:production": "AVEN_ENV=production cap sync ios",
    "build:ios:staging": "node scripts/build-ios.mjs staging",
    "build:ios:production": "node scripts/build-ios.mjs production",
    "icons": "node assets/make-icon.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2"
  }
}
