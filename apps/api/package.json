{
  "name": "@aven/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "tsc -p ../../packages/collab/tsconfig.json",
    "build": "nest build",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.mjs",
    "start": "node dist/main.js",
    "prestart:dev": "tsc -p ../../packages/collab/tsconfig.json",
    "start:dev": "nest start --watch",
    "vapid:generate": "node scripts/vapid.mjs",
    "billing:create-plan-products": "node scripts/create-plan-products.mjs",
    "pretypecheck": "tsc -p ../../packages/collab/tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:integration": "npm run build && node --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@aven/collab": "*",
    "@clerk/backend": "^3.31.4",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "compression": "^1.8.2",
    "docx": "^9.16.0",
    "dotenv": "^17.2.3",
    "pdfkit": "^0.21.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.5",
    "fflate": "^0.8.3",
    "prisma": "7.10.1",
    "typescript": "^6.0.0"
  }
}
