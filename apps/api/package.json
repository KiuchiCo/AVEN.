{
  "name": "@aven/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.mjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "vapid:generate": "node scripts/vapid.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:integration": "npm run build && node --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.30.0",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "^8.15.5",
    "prisma": "7.10.1",
    "typescript": "^6.0.0"
  }
}
