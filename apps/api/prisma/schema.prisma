generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  MEMBER
  GUEST
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DatabaseSortDirection {
  ASC
  DESC
}

enum DatabaseViewLayout {
  TABLE
  BOARD
  GALLERY
  CALENDAR
  LIST
  TIMELINE
  CHART
}

enum CalendarRecurrence {
  DAILY
  WEEKLY
  MONTHLY
}

enum CalendarEventType {
  MEETING
  FOCUS
  PERSONAL
  REMINDER
  OTHER
}

enum AutomationAction {
  SET_TASK_PRIORITY
  ADD_ACTIVITY_NOTE
}

enum AutomationRunStatus {
  SUCCEEDED
  FAILED
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  email             String            @unique @db.VarChar(320)
  displayName       String            @db.VarChar(120)
  identityIssuer    String?           @db.VarChar(512)
  identitySubject   String?           @db.VarChar(255)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  ownedWorkspaces   Workspace[]       @relation("WorkspaceCreator")
  memberships       WorkspaceMember[]
  personalWorkspace Workspace?        @relation("PersonalWorkspaceOwner")
  createdProjects   Project[]         @relation("ProjectCreator")
  createdProjectTemplates ProjectTemplate[] @relation("ProjectTemplateCreator")
  assignedTasks     Task[]            @relation("TaskAssignee")
  createdTasks      Task[]            @relation("TaskCreator")
  activityEntries   WorkspaceActivity[] @relation("ActivityActor")
  documentVersions DocumentVersion[] @relation("DocumentVersionCreator")
  documentComments DocumentComment[] @relation("DocumentCommentCreator")
  sentWorkspaceInvites WorkspaceInvite[] @relation("WorkspaceInviteCreator")
  activityReceipts    ActivityReceipt[]
  knowledgeItems      KnowledgeItem[] @relation("KnowledgeItemCreator")
  createdKnowledgeVersions KnowledgeVersion[] @relation("KnowledgeVersionCreator")
  createdAutomations AutomationRule[] @relation("AutomationRuleCreator")

  @@unique([identityIssuer, identitySubject])
  @@map("users")
}

model Workspace {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(120)
  createdById     String            @db.Uuid
  personalOwnerId String?           @unique @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  createdBy       User              @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  personalOwner   User?             @relation("PersonalWorkspaceOwner", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  members         WorkspaceMember[]
  projects        Project[]
  tasks           Task[]
  documents       Document[]
  events          CalendarEvent[]
  databases       WorkspaceDatabase[]
  databaseRecords DatabaseRecord[]
  databaseViews   DatabaseView[]
  recordLinks     DatabaseRecordLink[]
  milestones      ProjectMilestone[]
  projectTemplates ProjectTemplate[]
  activity        WorkspaceActivity[]
  documentVersions DocumentVersion[]
  documentComments DocumentComment[]
  invitations     WorkspaceInvite[]
  knowledgeItems  KnowledgeItem[]
  knowledgeVersions KnowledgeVersion[]
  automations     AutomationRule[]
  automationRuns  AutomationRun[]

  @@index([createdById])
  @@map("workspaces")
}

model WorkspaceInvite {
  id          String                @id @default(uuid()) @db.Uuid
  workspaceId String                @db.Uuid
  createdById String                @db.Uuid
  email       String                @db.VarChar(320)
  role        WorkspaceRole         @default(MEMBER)
  tokenHash   String                @unique @db.VarChar(64)
  status      WorkspaceInviteStatus @default(PENDING)
  expiresAt   DateTime              @db.Timestamptz(3)
  acceptedAt  DateTime?             @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation("WorkspaceInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([email, status, expiresAt])
  @@map("workspace_invites")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  createdById String        @db.Uuid
  name        String        @db.VarChar(160)
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  dueAt       DateTime?     @db.Timestamptz(3)
  budgetTotalCents Int?
  budgetSpentCents Int      @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User          @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]
  documents   Document[]
  knowledgeItems KnowledgeItem[] @relation("KnowledgeProject")
  knowledgeVersions KnowledgeVersion[] @relation("KnowledgeVersionProject")
  calendarEvents CalendarEvent[]
  milestones  ProjectMilestone[]

  @@index([workspaceId, status])
  @@index([workspaceId, dueAt])
  @@map("projects")
}

model Task {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  projectId   String?         @db.Uuid
  createdById String          @db.Uuid
  assigneeId  String?         @db.Uuid
  title       String          @db.VarChar(200)
  description String?         @db.Text
  status      TaskStatus      @default(TODO)
  priority    TaskPriority    @default(MEDIUM)
  dueAt       DateTime?       @db.Timestamptz(3)
  completedAt DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy   User            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee    User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events      CalendarEvent[]
  automationRuns AutomationRun[]
  knowledgeItems KnowledgeItem[] @relation("KnowledgeTask")
  knowledgeVersions KnowledgeVersion[] @relation("KnowledgeVersionTask")
  dependsOn   Task[]           @relation("TaskDependencies")
  blocks      Task[]           @relation("TaskDependencies")

  @@index([workspaceId, status, dueAt])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@map("tasks")
}

model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String    @db.Uuid
  title       String    @db.VarChar(160)
  dueAt       DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId, dueAt])
  @@map("project_milestones")
}

model ProjectTemplate {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @db.Uuid
  createdById       String   @db.Uuid
  name              String   @db.VarChar(160)
  description       String?  @db.Text
  taskTemplates     Json     @default("[]") @db.JsonB
  milestoneTemplates Json    @default("[]") @db.JsonB
  useCount          Int      @default(0)
  lastUsedAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         User @relation("ProjectTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, updatedAt])
  @@map("project_templates")
}

model WorkspaceActivity {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  actorId     String    @db.Uuid
  entityType  String    @db.VarChar(32)
  entityId    String    @db.Uuid
  message     String    @db.VarChar(240)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User      @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  receipts    ActivityReceipt[]

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("workspace_activity")
}

model ActivityReceipt {
  id         String           @id @default(uuid()) @db.Uuid
  activityId String           @db.Uuid
  userId     String           @db.Uuid
  readAt     DateTime?        @db.Timestamptz(3)
  dismissedAt DateTime?       @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  activity   WorkspaceActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([userId, readAt, dismissedAt])
  @@map("activity_receipts")
}

model Document {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String?   @db.Uuid
  title       String    @db.VarChar(200)
  content     String    @default("") @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  versions    DocumentVersion[]
  comments    DocumentComment[]
  knowledgeItems KnowledgeItem[] @relation("KnowledgeDocument")
  knowledgeVersions KnowledgeVersion[] @relation("KnowledgeVersionDocument")

  @@index([workspaceId, updatedAt])
  @@index([projectId])
  @@map("documents")
}

model KnowledgeItem {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  createdById String    @db.Uuid
  projectId   String?   @db.Uuid
  documentId  String?   @db.Uuid
  taskId      String?   @db.Uuid
  title       String    @db.VarChar(200)
  content     String    @db.Text
  sourceUrl   String?   @db.VarChar(2048)
  tags        String[]  @default([])
  isPinned    Boolean   @default(false)
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("KnowledgeItemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  project     Project?  @relation("KnowledgeProject", fields: [projectId], references: [id], onDelete: SetNull)
  document    Document? @relation("KnowledgeDocument", fields: [documentId], references: [id], onDelete: SetNull)
  task        Task?     @relation("KnowledgeTask", fields: [taskId], references: [id], onDelete: SetNull)
  versions    KnowledgeVersion[]

  @@index([workspaceId, archivedAt, isPinned, updatedAt])
  @@index([createdById])
  @@index([projectId])
  @@index([documentId])
  @@index([taskId])
  @@map("knowledge_items")
}

model KnowledgeVersion {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  knowledgeItemId String   @db.Uuid
  createdById     String   @db.Uuid
  projectId       String?  @db.Uuid
  documentId      String?  @db.Uuid
  taskId          String?  @db.Uuid
  title           String   @db.VarChar(200)
  content         String   @db.Text
  sourceUrl       String?  @db.VarChar(2048)
  tags            String[] @default([])
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  createdBy       User @relation("KnowledgeVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  project         Project? @relation("KnowledgeVersionProject", fields: [projectId], references: [id], onDelete: SetNull)
  document        Document? @relation("KnowledgeVersionDocument", fields: [documentId], references: [id], onDelete: SetNull)
  task            Task? @relation("KnowledgeVersionTask", fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, knowledgeItemId, createdAt])
  @@map("knowledge_versions")
}

model DocumentVersion {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  documentId  String   @db.Uuid
  createdById String   @db.Uuid
  title       String   @db.VarChar(200)
  content     String   @db.Text
  label       String?  @db.VarChar(120)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("DocumentVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, documentId, createdAt])
  @@map("document_versions")
}

model DocumentComment {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  documentId  String    @db.Uuid
  createdById String    @db.Uuid
  body        String    @db.VarChar(2000)
  resolvedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("DocumentCommentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, documentId, resolvedAt, createdAt])
  @@map("document_comments")
}

model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  taskId      String?   @db.Uuid
  projectId   String?   @db.Uuid
  title       String    @db.VarChar(200)
  description String?   @db.VarChar(2000)
  location    String?   @db.VarChar(250)
  type        CalendarEventType @default(MEETING)
  isAllDay    Boolean   @default(false)
  startsAt    DateTime  @db.Timestamptz(3)
  endsAt      DateTime? @db.Timestamptz(3)
  recurrence  CalendarRecurrence?
  recurrenceInterval Int  @default(1)
  recurrenceUntil DateTime? @db.Timestamptz(3)
  recurrenceTimeZone String? @db.VarChar(80)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startsAt])
  @@index([taskId])
  @@index([projectId])
  @@map("calendar_events")
}

model AutomationRule {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @db.Uuid
  createdById      String           @db.Uuid
  name             String           @db.VarChar(120)
  fromStatus       TaskStatus?
  toStatus         TaskStatus
  action           AutomationAction
  priority         TaskPriority?
  activityMessage  String?          @db.VarChar(500)
  enabled          Boolean          @default(true)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User             @relation("AutomationRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  runs             AutomationRun[]

  @@index([workspaceId, enabled, toStatus])
  @@map("automation_rules")
}

model AutomationRun {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  ruleId      String         @db.Uuid
  taskId      String?        @db.Uuid
  status      AutomationRunStatus @default(SUCCEEDED)
  summary     String         @db.VarChar(500)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([ruleId, createdAt])
  @@map("automation_runs")
}

model WorkspaceDatabase {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  name        String           @db.VarChar(160)
  description String?          @db.VarChar(500)
  properties  Json             @default("[{\"id\":\"name\",\"name\":\"Name\",\"type\":\"text\"},{\"id\":\"status\",\"name\":\"Status\",\"type\":\"status\"}]") @db.JsonB
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  records     DatabaseRecord[]
  views       DatabaseView[]

  @@index([workspaceId, updatedAt])
  @@map("workspace_databases")
}

model DatabaseRecord {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  databaseId  String           @db.Uuid
  values      Json             @default("{}") @db.JsonB
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  database    WorkspaceDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  outgoingLinks DatabaseRecordLink[] @relation("DatabaseRecordLinkSource")
  incomingLinks DatabaseRecordLink[] @relation("DatabaseRecordLinkTarget")

  @@index([workspaceId, databaseId, updatedAt])
  @@map("database_records")
}

model DatabaseRecordLink {
  id             String         @id @default(uuid()) @db.Uuid
  workspaceId    String         @db.Uuid
  propertyId     String         @db.VarChar(80)
  sourceRecordId String         @db.Uuid
  targetRecordId String         @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceRecord   DatabaseRecord @relation("DatabaseRecordLinkSource", fields: [sourceRecordId], references: [id], onDelete: Cascade)
  targetRecord   DatabaseRecord @relation("DatabaseRecordLinkTarget", fields: [targetRecordId], references: [id], onDelete: Cascade)

  @@unique([sourceRecordId, propertyId, targetRecordId])
  @@index([workspaceId, sourceRecordId, propertyId])
  @@index([workspaceId, targetRecordId])
  @@map("database_record_links")
}

model DatabaseView {
  id              String               @id @default(uuid()) @db.Uuid
  workspaceId     String               @db.Uuid
  databaseId      String               @db.Uuid
  name            String               @db.VarChar(80)
  filterQuery     String               @default("") @db.VarChar(200)
  sortPropertyId  String               @default("updatedAt") @db.VarChar(80)
  sortDirection   DatabaseSortDirection @default(DESC)
  layout          DatabaseViewLayout  @default(TABLE)
  groupByPropertyId String              @default("status") @db.VarChar(80)
  datePropertyId    String              @default("") @db.VarChar(80)
  chartPropertyId   String              @default("") @db.VarChar(80)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  database        WorkspaceDatabase    @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@unique([databaseId, name])
  @@index([workspaceId, databaseId, createdAt])
  @@map("database_views")
}
