generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  MEMBER
  GUEST
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DatabaseSortDirection {
  ASC
  DESC
}

enum DatabaseViewLayout {
  TABLE
  BOARD
  GALLERY
  CALENDAR
  LIST
  TIMELINE
  CHART
}

enum CalendarRecurrence {
  DAILY
  WEEKLY
  MONTHLY
}

enum CalendarEventType {
  MEETING
  FOCUS
  PERSONAL
  REMINDER
  OTHER
}

enum AutomationAction {
  SET_TASK_PRIORITY
  ADD_ACTIVITY_NOTE
}

enum AutomationRunStatus {
  SUCCEEDED
  FAILED
}

model User {
  id                          String              @id @default(uuid()) @db.Uuid
  email                       String              @unique @db.VarChar(320)
  displayName                 String              @db.VarChar(120)
  notifyTeamActivity          Boolean             @default(true)
  notifyTaskUpdates           Boolean             @default(true)
  pushSubscriptions           PushSubscription[]
  dashboardHiddenWidgets      String[]            @default([])
  emailNotifications          Boolean             @default(false)
  /// IANA name such as Australia/Sydney. Null means "use the device's own time zone".
  timeZone                    String?             @db.VarChar(64)
  /// Interface language (see auth/profile.ts). Null means English.
  language                    String?             @db.VarChar(8)
  emailEnabledAt              DateTime?           @db.Timestamptz(3)
  identityIssuer              String?             @db.VarChar(512)
  identitySubject             String?             @db.VarChar(255)
  createdAt                   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime            @updatedAt @db.Timestamptz(3)
  ownedWorkspaces             Workspace[]         @relation("WorkspaceCreator")
  memberships                 WorkspaceMember[]
  personalWorkspace           Workspace?          @relation("PersonalWorkspaceOwner")
  createdProjects             Project[]           @relation("ProjectCreator")
  createdProjectTemplates     ProjectTemplate[]   @relation("ProjectTemplateCreator")
  createdTaskViews            WorkspaceTaskView[] @relation("TaskViewCreator")
  assignedTasks               Task[]              @relation("TaskAssignee")
  createdTasks                Task[]              @relation("TaskCreator")
  activityEntries             WorkspaceActivity[] @relation("ActivityActor")
  documentVersions            DocumentVersion[]   @relation("DocumentVersionCreator")
  documentComments            DocumentComment[]   @relation("DocumentCommentCreator")
  sentWorkspaceInvites        WorkspaceInvite[]   @relation("WorkspaceInviteCreator")
  activityReceipts            ActivityReceipt[]
  knowledgeItems              KnowledgeItem[]     @relation("KnowledgeItemCreator")
  createdKnowledgeVersions    KnowledgeVersion[]  @relation("KnowledgeVersionCreator")
  createdAutomations          AutomationRule[]    @relation("AutomationRuleCreator")
  taskComments                TaskComment[]       @relation("TaskCommentAuthor")
  createdTaskChecklistItems   TaskChecklistItem[] @relation("TaskChecklistCreator")
  completedTaskChecklistItems TaskChecklistItem[] @relation("TaskChecklistCompleter")
  taskFollows                 TaskFollower[]

  fileFolders           FileFolder[]         @relation("FileFolderCreator")
  storedFiles           StoredFile[]         @relation("FileCreator")
  fileVersions          FileVersion[]        @relation("FileVersionCreator")
  fileAttachments       FileAttachment[]     @relation("FileAttachmentCreator")
  aiConversations       AiConversation[]
  aiUsage               AiUsage[]
  aiAgents              AiAgent[]
  workflows             Workflow[]
  whiteboards           Whiteboard[]
  channelsCreated       Channel[]            @relation("ChannelCreator")
  channelMessages       ChannelMessage[]     @relation("ChannelMessageAuthor")
  channelReads          ChannelRead[]        @relation("ChannelReader")
  calendarConnections   CalendarConnection[] @relation("CalendarConnector")
  favourites            Favourite[]          @relation("FavouriteOwner")
  documentSharesCreated DocumentShare[]      @relation("DocumentShareCreator")
  channelMemberships    ChannelMember[]      @relation("ChannelParticipant")

  @@unique([identityIssuer, identitySubject])
  @@map("users")
}

model Workspace {
  searchEmbeddings   SearchEmbedding[]
  id                 String               @id @default(uuid()) @db.Uuid
  name               String               @db.VarChar(120)
  createdById        String               @db.Uuid
  personalOwnerId    String?              @unique @db.Uuid
  /// Business-plan role requirements (see billing/permission-rules.ts). Empty means everyone can.
  permissionPolicy   Json                 @default("{}") @db.JsonB
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  createdBy          User                 @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  personalOwner      User?                @relation("PersonalWorkspaceOwner", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  members            WorkspaceMember[]
  projects           Project[]
  tasks              Task[]
  documents          Document[]
  events             CalendarEvent[]
  databases          WorkspaceDatabase[]
  databaseRecords    DatabaseRecord[]
  databaseViews      DatabaseView[]
  recordLinks        DatabaseRecordLink[]
  milestones         ProjectMilestone[]
  projectTemplates   ProjectTemplate[]
  activity           WorkspaceActivity[]
  documentVersions   DocumentVersion[]
  documentComments   DocumentComment[]
  invitations        WorkspaceInvite[]
  knowledgeItems     KnowledgeItem[]
  knowledgeVersions  KnowledgeVersion[]
  automations        AutomationRule[]
  automationRuns     AutomationRun[]
  taskComments       TaskComment[]
  taskChecklistItems TaskChecklistItem[]
  taskFollowers      TaskFollower[]
  taskViews          WorkspaceTaskView[]

  fileFolders         FileFolder[]
  storedFiles         StoredFile[]
  fileVersions        FileVersion[]
  fileAttachments     FileAttachment[]
  aiConversations     AiConversation[]
  aiUsage             AiUsage[]
  aiAgents            AiAgent[]
  workflows           Workflow[]
  workflowRuns        WorkflowRun[]
  subscription        Subscription?
  whiteboards         Whiteboard[]
  channels            Channel[]
  favourites          Favourite[]
  documentShares      DocumentShare[]
  calendarConnections CalendarConnection[]
  billingInvoices     BillingInvoice[]
  syncedBlocks        SyncedBlock[]

  @@index([createdById])
  @@map("workspaces")
}

model WorkspaceInvite {
  id          String                @id @default(uuid()) @db.Uuid
  workspaceId String                @db.Uuid
  createdById String                @db.Uuid
  email       String                @db.VarChar(320)
  role        WorkspaceRole         @default(MEMBER)
  tokenHash   String                @unique @db.VarChar(64)
  status      WorkspaceInviteStatus @default(PENDING)
  expiresAt   DateTime              @db.Timestamptz(3)
  acceptedAt  DateTime?             @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation("WorkspaceInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([email, status, expiresAt])
  @@map("workspace_invites")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Project {
  id                String             @id @default(uuid()) @db.Uuid
  workspaceId       String             @db.Uuid
  createdById       String             @db.Uuid
  name              String             @db.VarChar(160)
  description       String?            @db.Text
  status            ProjectStatus      @default(PLANNING)
  dueAt             DateTime?          @db.Timestamptz(3)
  budgetTotalCents  Int?
  budgetSpentCents  Int                @default(0)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         User               @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks             Task[]
  documents         Document[]
  knowledgeItems    KnowledgeItem[]    @relation("KnowledgeProject")
  knowledgeVersions KnowledgeVersion[] @relation("KnowledgeVersionProject")
  calendarEvents    CalendarEvent[]
  milestones        ProjectMilestone[]

  fileAttachments FileAttachment[]

  @@index([workspaceId, status])
  @@index([workspaceId, dueAt])
  @@map("projects")
}

model Task {
  id                  String              @id @default(uuid()) @db.Uuid
  workspaceId         String              @db.Uuid
  projectId           String?             @db.Uuid
  createdById         String              @db.Uuid
  assigneeId          String?             @db.Uuid
  parentId            String?             @db.Uuid
  title               String              @db.VarChar(200)
  description         String?             @db.Text
  status              TaskStatus          @default(TODO)
  priority            TaskPriority        @default(MEDIUM)
  labels              String[]            @default([])
  startAt             DateTime?           @db.Timestamptz(3)
  dueAt               DateTime?           @db.Timestamptz(3)
  completedAt         DateTime?           @db.Timestamptz(3)
  recurrence          CalendarRecurrence?
  recurrenceInterval  Int                 @default(1)
  recurrenceUntil     DateTime?           @db.Timestamptz(3)
  recurrenceSpawnedAt DateTime?           @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent              Task?               @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks            Task[]              @relation("TaskSubtasks")
  createdBy           User                @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee            User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events              CalendarEvent[]
  automationRuns      AutomationRun[]
  knowledgeItems      KnowledgeItem[]     @relation("KnowledgeTask")
  knowledgeVersions   KnowledgeVersion[]  @relation("KnowledgeVersionTask")
  dependsOn           Task[]              @relation("TaskDependencies")
  blocks              Task[]              @relation("TaskDependencies")
  comments            TaskComment[]
  checklistItems      TaskChecklistItem[]
  followers           TaskFollower[]

  fileAttachments FileAttachment[]

  @@index([workspaceId, status, dueAt])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([parentId])
  @@map("tasks")
}

model TaskComment {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  taskId           String    @db.Uuid
  authorId         String    @db.Uuid
  body             String    @db.VarChar(2000)
  mentionedUserIds String[]  @default([])
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author           User      @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, taskId, createdAt])
  @@map("task_comments")
}

model TaskChecklistItem {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @db.Uuid
  taskId        String    @db.Uuid
  createdById   String    @db.Uuid
  completedById String?   @db.Uuid
  title         String    @db.VarChar(240)
  position      Int       @default(0)
  completedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy     User      @relation("TaskChecklistCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy   User?     @relation("TaskChecklistCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, taskId, position])
  @@map("task_checklist_items")
}

model TaskFollower {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  taskId      String    @db.Uuid
  userId      String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([workspaceId, taskId])
  @@map("task_followers")
}

model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String    @db.Uuid
  title       String    @db.VarChar(160)
  dueAt       DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId, dueAt])
  @@map("project_milestones")
}

model ProjectTemplate {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @db.Uuid
  createdById        String    @db.Uuid
  name               String    @db.VarChar(160)
  description        String?   @db.Text
  taskTemplates      Json      @default("[]") @db.JsonB
  milestoneTemplates Json      @default("[]") @db.JsonB
  useCount           Int       @default(0)
  lastUsedAt         DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy          User      @relation("ProjectTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, updatedAt])
  @@map("project_templates")
}

model WorkspaceTaskView {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  createdById String    @db.Uuid
  name        String    @db.VarChar(60)
  filters     Json      @db.JsonB
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("TaskViewCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt])
  @@map("workspace_task_views")
}

model WorkspaceActivity {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @db.Uuid
  actorId         String            @db.Uuid
  entityType      String            @db.VarChar(32)
  entityId        String            @db.Uuid
  message         String            @db.VarChar(240)
  recipientScoped Boolean           @default(false)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor           User              @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  receipts        ActivityReceipt[]

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("workspace_activity")
}

model ActivityReceipt {
  id                   String            @id @default(uuid()) @db.Uuid
  activityId           String            @db.Uuid
  userId               String            @db.Uuid
  isNotificationTarget Boolean           @default(false)
  readAt               DateTime?         @db.Timestamptz(3)
  dismissedAt          DateTime?         @db.Timestamptz(3)
  /// When this notification was included in an email (null = not emailed).
  emailedAt            DateTime?         @db.Timestamptz(3)
  /// When this notification was sent as a browser push (null = not pushed).
  pushedAt             DateTime?         @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)
  activity             WorkspaceActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([userId, readAt, dismissedAt])
  @@index([userId, isNotificationTarget, activityId])
  @@index([isNotificationTarget, emailedAt, createdAt])
  @@index([isNotificationTarget, pushedAt, createdAt])
  @@map("activity_receipts")
}

model Document {
  id                String             @id @default(uuid()) @db.Uuid
  workspaceId       String             @db.Uuid
  projectId         String?            @db.Uuid
  title             String             @db.VarChar(200)
  content           String             @default("") @db.Text
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  versions          DocumentVersion[]
  comments          DocumentComment[]
  knowledgeItems    KnowledgeItem[]    @relation("KnowledgeDocument")
  knowledgeVersions KnowledgeVersion[] @relation("KnowledgeVersionDocument")

  fileAttachments FileAttachment[]
  shares          DocumentShare[]

  @@index([workspaceId, updatedAt])
  @@index([projectId])
  @@map("documents")
}

model KnowledgeItem {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @db.Uuid
  createdById String             @db.Uuid
  projectId   String?            @db.Uuid
  documentId  String?            @db.Uuid
  taskId      String?            @db.Uuid
  title       String             @db.VarChar(200)
  content     String             @db.Text
  sourceUrl   String?            @db.VarChar(2048)
  tags        String[]           @default([])
  isPinned    Boolean            @default(false)
  archivedAt  DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("KnowledgeItemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  project     Project?           @relation("KnowledgeProject", fields: [projectId], references: [id], onDelete: SetNull)
  document    Document?          @relation("KnowledgeDocument", fields: [documentId], references: [id], onDelete: SetNull)
  task        Task?              @relation("KnowledgeTask", fields: [taskId], references: [id], onDelete: SetNull)
  versions    KnowledgeVersion[]

  @@index([workspaceId, archivedAt, isPinned, updatedAt])
  @@index([createdById])
  @@index([projectId])
  @@index([documentId])
  @@index([taskId])
  @@map("knowledge_items")
}

model KnowledgeVersion {
  id              String        @id @default(uuid()) @db.Uuid
  workspaceId     String        @db.Uuid
  knowledgeItemId String        @db.Uuid
  createdById     String        @db.Uuid
  projectId       String?       @db.Uuid
  documentId      String?       @db.Uuid
  taskId          String?       @db.Uuid
  title           String        @db.VarChar(200)
  content         String        @db.Text
  sourceUrl       String?       @db.VarChar(2048)
  tags            String[]      @default([])
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("KnowledgeVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  project         Project?      @relation("KnowledgeVersionProject", fields: [projectId], references: [id], onDelete: SetNull)
  document        Document?     @relation("KnowledgeVersionDocument", fields: [documentId], references: [id], onDelete: SetNull)
  task            Task?         @relation("KnowledgeVersionTask", fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, knowledgeItemId, createdAt])
  @@map("knowledge_versions")
}

model DocumentVersion {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  documentId  String    @db.Uuid
  createdById String    @db.Uuid
  title       String    @db.VarChar(200)
  content     String    @db.Text
  label       String?   @db.VarChar(120)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("DocumentVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, documentId, createdAt])
  @@map("document_versions")
}

model DocumentComment {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @db.Uuid
  documentId  String            @db.Uuid
  createdById String            @db.Uuid
  body        String            @db.VarChar(2000)
  /// The block this comment is about, and the words it quotes from that block, so it can be shown beside them.
  blockId     String?           @db.VarChar(64)
  quote       String?           @db.VarChar(300)
  /// Set on a reply: the comment it answers (always a top-level comment of the same document).
  parentId    String?           @db.Uuid
  resolvedAt  DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("DocumentCommentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  parent      DocumentComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     DocumentComment[] @relation("CommentReplies")

  @@index([workspaceId, documentId, resolvedAt, createdAt])
  @@index([parentId])
  @@map("document_comments")
}

model CalendarEvent {
  id                 String              @id @default(uuid()) @db.Uuid
  workspaceId        String              @db.Uuid
  taskId             String?             @db.Uuid
  projectId          String?             @db.Uuid
  title              String              @db.VarChar(200)
  description        String?             @db.VarChar(2000)
  location           String?             @db.VarChar(250)
  type               CalendarEventType   @default(MEETING)
  isAllDay           Boolean             @default(false)
  startsAt           DateTime            @db.Timestamptz(3)
  endsAt             DateTime?           @db.Timestamptz(3)
  recurrence         CalendarRecurrence?
  recurrenceInterval Int                 @default(1)
  recurrenceUntil    DateTime?           @db.Timestamptz(3)
  recurrenceTimeZone String?             @db.VarChar(80)
  externalUid        String?             @db.VarChar(255)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task               Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)

  externalLinks ExternalEventLink[]

  @@unique([workspaceId, externalUid])
  @@index([workspaceId, startsAt])
  @@index([taskId])
  @@index([projectId])
  @@map("calendar_events")
}

model AutomationRule {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @db.Uuid
  createdById     String           @db.Uuid
  name            String           @db.VarChar(120)
  fromStatus      TaskStatus?
  toStatus        TaskStatus
  action          AutomationAction
  priority        TaskPriority?
  activityMessage String?          @db.VarChar(500)
  enabled         Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("AutomationRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  runs            AutomationRun[]

  @@index([workspaceId, enabled, toStatus])
  @@map("automation_rules")
}

model AutomationRun {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  ruleId      String              @db.Uuid
  taskId      String?             @db.Uuid
  status      AutomationRunStatus @default(SUCCEEDED)
  summary     String              @db.VarChar(500)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule        AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  task        Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([ruleId, createdAt])
  @@map("automation_runs")
}

model WorkspaceDatabase {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  name        String           @db.VarChar(160)
  description String?          @db.VarChar(500)
  properties  Json             @default("[{\"id\":\"name\",\"name\":\"Name\",\"type\":\"text\"},{\"id\":\"status\",\"name\":\"Status\",\"type\":\"status\"}]") @db.JsonB
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  records     DatabaseRecord[]
  views       DatabaseView[]

  @@index([workspaceId, updatedAt])
  @@map("workspace_databases")
}

model DatabaseRecord {
  id            String               @id @default(uuid()) @db.Uuid
  workspaceId   String               @db.Uuid
  databaseId    String               @db.Uuid
  values        Json                 @default("{}") @db.JsonB
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  database      WorkspaceDatabase    @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  outgoingLinks DatabaseRecordLink[] @relation("DatabaseRecordLinkSource")
  incomingLinks DatabaseRecordLink[] @relation("DatabaseRecordLinkTarget")

  @@index([workspaceId, databaseId, updatedAt])
  @@map("database_records")
}

model DatabaseRecordLink {
  id             String         @id @default(uuid()) @db.Uuid
  workspaceId    String         @db.Uuid
  propertyId     String         @db.VarChar(80)
  sourceRecordId String         @db.Uuid
  targetRecordId String         @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceRecord   DatabaseRecord @relation("DatabaseRecordLinkSource", fields: [sourceRecordId], references: [id], onDelete: Cascade)
  targetRecord   DatabaseRecord @relation("DatabaseRecordLinkTarget", fields: [targetRecordId], references: [id], onDelete: Cascade)

  @@unique([sourceRecordId, propertyId, targetRecordId])
  @@index([workspaceId, sourceRecordId, propertyId])
  @@index([workspaceId, targetRecordId])
  @@map("database_record_links")
}

model DatabaseView {
  id                String                @id @default(uuid()) @db.Uuid
  workspaceId       String                @db.Uuid
  databaseId        String                @db.Uuid
  name              String                @db.VarChar(80)
  filterQuery       String                @default("") @db.VarChar(200)
  sortPropertyId    String                @default("updatedAt") @db.VarChar(80)
  sortDirection     DatabaseSortDirection @default(DESC)
  layout            DatabaseViewLayout    @default(TABLE)
  groupByPropertyId String                @default("status") @db.VarChar(80)
  datePropertyId    String                @default("") @db.VarChar(80)
  chartPropertyId   String                @default("") @db.VarChar(80)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  database          WorkspaceDatabase     @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@unique([databaseId, name])
  @@index([workspaceId, databaseId, createdAt])
  @@map("database_views")
}

model FileFolder {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  parentId    String?      @db.Uuid
  createdById String       @db.Uuid
  name        String       @db.VarChar(255)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      FileFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    FileFolder[] @relation("FolderTree")
  createdBy   User         @relation("FileFolderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  files       StoredFile[]

  @@index([workspaceId, parentId])
  @@map("file_folders")
}

/// File contents live in object storage under storageKey; only metadata is in PostgreSQL.
model StoredFile {
  id           String               @id @default(uuid()) @db.Uuid
  workspaceId  String               @db.Uuid
  folderId     String?              @db.Uuid
  createdById  String               @db.Uuid
  name         String               @db.VarChar(255)
  mimeType     String               @db.VarChar(127)
  sizeBytes    Int
  checksum     String               @db.VarChar(64)
  storageKey   String               @unique @db.VarChar(255)
  version      Int                  @default(1)
  deletedAt    DateTime?            @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder       FileFolder?          @relation(fields: [folderId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("FileCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions     FileVersion[]
  attachments  FileAttachment[]
  messageFiles ChannelMessageFile[]

  @@index([workspaceId, folderId, deletedAt])
  @@index([workspaceId, deletedAt])
  @@map("stored_files")
}

/// Earlier contents of a file that was replaced. The current contents are on StoredFile itself.
model FileVersion {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  fileId      String     @db.Uuid
  createdById String     @db.Uuid
  version     Int
  mimeType    String     @db.VarChar(127)
  sizeBytes   Int
  checksum    String     @db.VarChar(64)
  storageKey  String     @unique @db.VarChar(255)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file        StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy   User       @relation("FileVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([fileId, version])
  @@index([workspaceId])
  @@map("file_versions")
}

/// Links a file to exactly one task, document, or project (enforced by a CHECK constraint in the migration).
model FileAttachment {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  fileId      String     @db.Uuid
  taskId      String?    @db.Uuid
  documentId  String?    @db.Uuid
  projectId   String?    @db.Uuid
  createdById String     @db.Uuid
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file        StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  document    Document?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User       @relation("FileAttachmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([fileId, taskId])
  @@unique([fileId, documentId])
  @@unique([fileId, projectId])
  @@index([workspaceId, taskId])
  @@index([workspaceId, documentId])
  @@index([workspaceId, projectId])
  @@map("file_attachments")
}

/// A private chat between one member and AVEN Intelligence, inside one workspace.
model AiConversation {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  userId      String      @db.Uuid
  title       String      @db.VarChar(120)
  /// "general", a built-in agent ("system:project-manager"), or the id of a custom AiAgent.
  agentKey    String      @default("general") @db.VarChar(64)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AiMessage[]
  usage       AiUsage[]

  @@index([workspaceId, userId, updatedAt])
  @@map("ai_conversations")
}

/// `content` holds provider-neutral blocks (text, tool_use, tool_result) so a conversation can be replayed to any provider.
/// `kind` is "tool_result" for the hidden turns that carry tool output back to the model.
model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  role           String         @db.VarChar(12)
  kind           String         @default("text") @db.VarChar(12)
  content        Json           @db.JsonB
  citations      Json           @default("[]") @db.JsonB
  pendingActions Json           @default("[]") @db.JsonB
  model          String?        @db.VarChar(100)
  inputTokens    Int            @default(0)
  outputTokens   Int            @default(0)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// One row per model call. Credits are what the monthly allowance is measured in.
model AiUsage {
  id             String          @id @default(uuid()) @db.Uuid
  workspaceId    String          @db.Uuid
  userId         String          @db.Uuid
  conversationId String?         @db.Uuid
  model          String          @db.VarChar(100)
  inputTokens    Int
  outputTokens   Int
  credits        Int
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("ai_usage")
}

/// A member-created assistant role. Built-in agents live in code. `tools` can only name known tools, and
/// the base safety rules always come before `instructions`.
model AiAgent {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  createdById  String    @db.Uuid
  name         String    @db.VarChar(80)
  description  String    @db.VarChar(240)
  instructions String    @db.VarChar(4000)
  tools        String[]  @default([])
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@map("ai_agents")
}

/// A multi-step automation. `trigger` and `steps` are validated JSON (see workflow-rules.ts); steps form a tree
/// where a branch step holds `then` and `else` lists. It runs as its creator, with the creator's permissions.
model Workflow {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  createdById String        @db.Uuid
  name        String        @db.VarChar(120)
  description String        @default("") @db.VarChar(500)
  enabled     Boolean       @default(false)
  trigger     Json          @db.JsonB
  steps       Json          @db.JsonB
  /// Next time a scheduled workflow is due; null for other triggers.
  nextRunAt   DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]

  @@unique([workspaceId, name])
  @@index([workspaceId, enabled])
  @@index([enabled, nextRunAt])
  @@map("workflows")
}

/// One execution. `cursor` holds the position in the step tree and the values produced so far, so a run can
/// pause (delay, retry) and resume later, even after a restart. Status: QUEUED, RUNNING, WAITING, SUCCEEDED, FAILED.
model WorkflowRun {
  id          String            @id @default(uuid()) @db.Uuid
  workflowId  String            @db.Uuid
  workspaceId String            @db.Uuid
  status      String            @default("QUEUED") @db.VarChar(12)
  trigger     Json              @db.JsonB
  cursor      Json              @default("{}") @db.JsonB
  /// Failed attempts of the current step.
  attempts    Int               @default(0)
  /// Earliest time the run may continue.
  runAt       DateTime          @default(now()) @db.Timestamptz(3)
  lockedAt    DateTime?         @db.Timestamptz(3)
  startedAt   DateTime?         @db.Timestamptz(3)
  finishedAt  DateTime?         @db.Timestamptz(3)
  error       String?           @db.VarChar(500)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  workflow    Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stepRuns    WorkflowStepRun[]

  @@index([status, runAt])
  @@index([workflowId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("workflow_runs")
}

/// What happened at each step of a run, including failed attempts that were retried.
model WorkflowStepRun {
  id         String      @id @default(uuid()) @db.Uuid
  runId      String      @db.Uuid
  stepId     String      @db.VarChar(40)
  type       String      @db.VarChar(20)
  /// SUCCEEDED, FAILED, RETRYING, or SKIPPED
  status     String      @db.VarChar(12)
  attempt    Int         @default(1)
  summary    String      @default("") @db.VarChar(500)
  startedAt  DateTime    @default(now()) @db.Timestamptz(3)
  finishedAt DateTime?   @db.Timestamptz(3)
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, startedAt])
  @@map("workflow_step_runs")
}

/// The paid plan of a workspace. No row means the Free plan. Rows are changed only by verified payment-provider
/// webhooks (or by hand for Enterprise agreements, using `limitsOverride`).
model Subscription {
  id                     String    @id @default(uuid()) @db.Uuid
  workspaceId            String    @unique @db.Uuid
  planKey                String    @db.VarChar(20)
  /// ACTIVE, TRIALING, PAST_DUE keep paid limits; anything else counts as Free.
  status                 String    @db.VarChar(20)
  seats                  Int       @default(1)
  currentPeriodEnd       DateTime? @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean   @default(false)
  provider               String?   @db.VarChar(20)
  providerCustomerId     String?   @db.VarChar(100)
  providerSubscriptionId String?   @unique @db.VarChar(100)
  limitsOverride         Json?     @db.JsonB
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Every webhook event processed, so a repeated delivery is recognised and ignored.
model BillingEvent {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @db.VarChar(20)
  providerEventId String   @db.VarChar(100)
  type            String   @db.VarChar(80)
  workspaceId     String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@map("billing_events")
}

/// Billing history shown to workspace owners, copied from the provider's invoices.
model BillingInvoice {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @db.Uuid
  providerInvoiceId String    @unique @db.VarChar(100)
  number            String?   @db.VarChar(60)
  status            String    @db.VarChar(20)
  amountCents       Int
  currency          String    @db.VarChar(3)
  hostedUrl         String?   @db.VarChar(500)
  periodStart       DateTime? @db.Timestamptz(3)
  periodEnd         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("billing_invoices")
}

model Whiteboard {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  createdById String    @db.Uuid
  name        String    @db.VarChar(120)
  /// { elements: [...] } checked by parseElements before it is stored.
  content     Json      @db.JsonB
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
  @@map("whiteboards")
}

enum ChannelKind {
  CHANNEL
  DIRECT
  GROUP
}

model Channel {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  createdById String           @db.Uuid
  kind        ChannelKind      @default(CHANNEL)
  /// Lowercase letters, digits and hyphens. Null for direct and group conversations.
  name        String?          @db.VarChar(40)
  /// Sorted participant ids of a direct conversation, so each pair has exactly one.
  dmKey       String?          @db.VarChar(80)
  topic       String           @default("") @db.VarChar(200)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages    ChannelMessage[]
  reads       ChannelRead[]
  members     ChannelMember[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, dmKey])
  @@map("channels")
}

model ChannelMessage {
  id          String               @id @default(uuid()) @db.Uuid
  channelId   String               @db.Uuid
  workspaceId String               @db.Uuid
  authorId    String               @db.Uuid
  body        String               @db.VarChar(4000)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  editedAt    DateTime?            @db.Timestamptz(3)
  /// A deleted message keeps its row (so the thread order holds) but its text is cleared.
  deletedAt   DateTime?            @db.Timestamptz(3)
  /// A reply belongs to a root message. Replies to replies are not allowed.
  parentId    String?              @db.Uuid
  channel     Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User                 @relation("ChannelMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent      ChannelMessage?      @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ChannelMessage[]     @relation("MessageReplies")
  files       ChannelMessageFile[]

  @@index([channelId, createdAt])
  @@index([parentId, createdAt])
  @@map("channel_messages")
}

/// A workspace file shared in a message. The file itself stays in Files; this only links it.
model ChannelMessageFile {
  messageId String         @db.Uuid
  fileId    String         @db.Uuid
  message   ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file      StoredFile     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([messageId, fileId])
  @@index([fileId])
  @@map("channel_message_files")
}

/// Who is in a direct or group conversation. Public channels have no rows: every workspace member can see them.
model ChannelMember {
  channelId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation("ChannelParticipant", fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
  @@map("channel_members")
}

model ChannelRead {
  channelId  String   @db.Uuid
  userId     String   @db.Uuid
  lastReadAt DateTime @db.Timestamptz(3)
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User     @relation("ChannelReader", fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@map("channel_reads")
}

enum CalendarProviderKey {
  GOOGLE
  MICROSOFT
}

/// A calendar account linked to a workspace, by one person. Tokens are stored encrypted, never in clear text.
model CalendarConnection {
  id              String              @id @default(uuid()) @db.Uuid
  workspaceId     String              @db.Uuid
  connectedById   String              @db.Uuid
  provider        CalendarProviderKey
  accountEmail    String              @db.VarChar(320)
  accessTokenEnc  String              @db.Text
  refreshTokenEnc String              @db.Text
  expiresAt       DateTime            @db.Timestamptz(3)
  /// Also send events made in AVEN to this calendar. Off unless the person asked for it.
  pushEnabled     Boolean             @default(false)
  /// ACTIVE, or NEEDS_ATTENTION when the provider refused our tokens and the person must reconnect.
  status          String              @default("ACTIVE") @db.VarChar(20)
  lastSyncedAt    DateTime?           @db.Timestamptz(3)
  lastError       String?             @db.VarChar(300)
  /// Set while a sync runs, so two servers never sync the same account at once. Older than ten minutes counts as abandoned.
  syncingSince    DateTime?           @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy     User                @relation("CalendarConnector", fields: [connectedById], references: [id], onDelete: Cascade)
  links           ExternalEventLink[]

  @@unique([workspaceId, provider, accountEmail])
  @@index([status, lastSyncedAt])
  @@map("calendar_connections")
}

/// Pairs an AVEN event with the same event on a provider, so syncing never creates a duplicate.
/// A link with no event means the event was deleted in AVEN: it is kept so the deletion is not undone by the next sync.
model ExternalEventLink {
  id            String             @id @default(uuid()) @db.Uuid
  connectionId  String             @db.Uuid
  eventId       String?            @db.Uuid
  externalId    String             @db.VarChar(255)
  /// The provider's version marker for the last copy we saw.
  etag          String?            @db.VarChar(255)
  /// The AVEN event's updatedAt when the two were last made equal.
  localSyncedAt DateTime           @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  connection    CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  event         CalendarEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalId])
  @@index([connectionId, eventId])
  @@index([eventId])
  @@map("external_event_links")
}

/// A read-only link to one document, for people without an AVEN account. Only a hash of the link's secret is stored.
model DocumentShare {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @db.Uuid
  documentId    String    @db.Uuid
  createdById   String    @db.Uuid
  tokenHash     String    @unique @db.VarChar(64)
  /// What the link allows. Only VIEW exists; the column keeps room for other levels.
  accessLevel   String    @default("VIEW") @db.VarChar(16)
  /// Whether readers may download the document as PDF or Word, and whether the page may be printed.
  allowDownload Boolean   @default(false)
  allowPrint    Boolean   @default(true)
  /// Whether databases embedded in the document are shown (read-only) to readers. Off: they show as restricted.
  includeEmbeds Boolean   @default(false)
  expiresAt     DateTime? @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  viewCount     Int       @default(0)
  lastViewedAt  DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy     User      @relation("DocumentShareCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_shares")
}

enum FavouriteKind {
  PROJECT
  DOCUMENT
  DATABASE
  WHITEBOARD
}

/// Something a person has pinned to the Favourites section of their sidebar. Private to that person, per workspace.
model Favourite {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  workspaceId String        @db.Uuid
  kind        FavouriteKind
  entityId    String        @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  user        User          @relation("FavouriteOwner", fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, entityId])
  @@index([userId, workspaceId, createdAt])
  @@map("favourites")
}

/// One browser (or device) that agreed to receive notifications. The endpoint is the push service's address for it.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique @db.VarChar(1000)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Meaning vectors for semantic search: one row per chunk of a document or Knowledge item. Plain float arrays, so no database extension is needed.
model SearchEmbedding {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  entityType  String    @db.VarChar(20)
  entityId    String    @db.Uuid
  chunkIndex  Int
  /// Hash of the entity's text at the time it was embedded; a different hash means the entity changed and is re-embedded.
  contentHash String    @db.VarChar(64)
  model       String    @db.VarChar(100)
  excerpt     String    @db.VarChar(400)
  vector      Float[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, chunkIndex])
  @@index([workspaceId, entityType])
  @@map("search_embeddings")
}

/// The shared text of a synced block. Every document block with this id shows and edits the same text.
model SyncedBlock {
  id          String    @id @db.Uuid
  workspaceId String    @db.Uuid
  text        String    @default("") @db.Text
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("synced_blocks")
}
