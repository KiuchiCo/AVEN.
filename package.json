{
  "name": "aven-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @aven/web",
    "dev:api": "npm run start:dev --workspace @aven/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:generate": "npm run db:generate --workspace @aven/api",
    "db:validate": "npm run db:validate --workspace @aven/api",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @aven/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @aven/api"
  }
}
