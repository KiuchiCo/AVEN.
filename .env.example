# Local AVEN web/API settings. Fill Clerk keys before using sign-in.
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Clerk development instance. Keep this file out of Git. The publishable key
# is public; never expose the secret key to browser code.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: set the PEM public key for networkless verification. If omitted, the API uses CLERK_SECRET_KEY.
CLERK_JWT_KEY=
CLERK_ISSUER=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Local PostgreSQL values for docker compose. Change these for shared environments.
POSTGRES_USER=aven
POSTGRES_PASSWORD=aven-local-only
POSTGRES_DB=aven
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aven:aven-local-only@localhost:5432/aven?schema=public

# File storage. Files are written under STORAGE_DIR (relative to where the API runs); only metadata is kept in PostgreSQL.
# STORAGE_DIR=.storage
# MAX_UPLOAD_BYTES=26214400
# WORKSPACE_STORAGE_QUOTA_BYTES=524288000

# AVEN Intelligence (model-backed assistant). Without a key the assistant stays off and the app says so.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_MONTHLY_CREDITS=2000
# AI_MAX_OUTPUT_TOKENS=2048
