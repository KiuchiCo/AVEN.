# Local AVEN web/API settings. Fill Clerk keys before using sign-in.
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Clerk development instance. Keep this file out of Git. The publishable key
# is public; never expose the secret key to browser code.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: set the PEM public key for networkless verification. If omitted, the API uses CLERK_SECRET_KEY.
CLERK_JWT_KEY=
CLERK_ISSUER=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Local PostgreSQL values for docker compose. Change these for shared environments.
POSTGRES_USER=aven
POSTGRES_PASSWORD=aven-local-only
POSTGRES_DB=aven
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aven:aven-local-only@localhost:5432/aven?schema=public

# File storage. Files are written under STORAGE_DIR (relative to where the API runs); only metadata is kept in PostgreSQL.
# STORAGE_DIR=.storage
# Use S3-compatible object storage instead of local disk:
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=   # only for non-AWS stores
# Cloudflare R2 (S3-compatible): STORAGE_DRIVER=s3, S3_REGION=auto, S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
# S3_BUCKET=<bucket>, and an R2 API token's access key id and secret as S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY. Keep the bucket private:
# files are only ever served through AVEN's own permission checks.
# MAX_UPLOAD_BYTES=26214400
# WORKSPACE_STORAGE_QUOTA_BYTES=524288000

# AVEN Intelligence (model-backed assistant). Uses Google AI Studio's Gemini API from the API server only; the key never reaches the browser or the app.
# Without a key the assistant stays off and the app says so. Create a key in Google AI Studio (aistudio.google.com).
# GOOGLE_AI_API_KEY=
# The default is Google's "gemini-flash-latest" alias, which follows the current Flash model. Pin a model id if you prefer, and check
# that your free-tier key can use it in AI Studio. An unavailable model gives a clear message naming AI_MODEL.
# AI_MODEL=gemini-flash-latest
# AI_MONTHLY_CREDITS=2000
# AI_MAX_OUTPUT_TOKENS=2048
# To switch provider later: AI_PROVIDER=anthropic plus ANTHROPIC_API_KEY (and AI_MODEL). Only the chosen provider's key is read.
# AI_PROVIDER=gemini
# Optional web search for the assistant (Tavily). Without a key the assistant answers from the workspace only.
# TAVILY_API_KEY=
# TAVILY_BASE_URL=https://api.tavily.com

# Optional search by meaning (Pro plan and above). Any OpenAI-compatible embeddings endpoint: OpenAI, Voyage, Mistral, a local server.
# Without a key the Search page says it is awaiting a provider. Note: document and Knowledge text is sent to this provider to be embedded.
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small

# Browser push notifications. Generate keys with `npm run build --workspace @aven/api && npm run vapid:generate --workspace @aven/api`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Workflows run inside the API process. Set WORKFLOWS_DISABLED=true on any instance that should not run them.
# WORKFLOWS_DISABLED=false
# Development only: lets webhooks call localhost. Refused when NODE_ENV=production.
# WORKFLOW_ALLOW_PRIVATE_WEBHOOKS=false

# Email (invitations and notification summaries). Without a key nothing is sent and the app says so.
# Uses Resend's HTTP API; EMAIL_FROM must be an address you have verified with the provider.
# Use a separate Resend key (and, ideally, a separate sender) for development and production.
# EMAIL_API_KEY=
# EMAIL_FROM=AVEN <hello@your-domain.example>
# EMAIL_DISABLED=false

# Billing (Stripe Checkout + customer portal). Without keys everyone stays on the Free plan and the app says plans can't be changed.
# Create one recurring monthly price per plan in Stripe (A$9.99, A$19.99, A$29.99 per seat) and paste their ids.
# Point a Stripe webhook at POST <api>/api/v1/billing/webhook for: checkout.session.completed, customer.subscription.*, invoice.*
# Development: use Stripe TEST mode keys (sk_test_...) and test cards only. Keep live keys for production, never in a development file.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PLUS=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
# Or create the three test-mode products and prices for you (with the Managed Payments tax code), then paste the printed ids:
#   STRIPE_SECRET_KEY=sk_test_... npm run billing:create-plan-products --workspace @aven/api -- --create
# Stripe Managed Payments: Stripe becomes the seller of record and handles sales tax, VAT/GST, fraud checks and order support.
# Needs it switched on for your Stripe account and eligible products; checkout then uses Stripe API version 2026-02-25.preview.
# STRIPE_MANAGED_PAYMENTS=false
# Optional JSON to change plan limits without a code change, e.g. {"PLUS":{"limits":{"projects":40}}}
# BILLING_PLAN_OVERRIDES=

# Calendar sync (Google Calendar and Outlook). Each needs an OAuth app you create with the provider; without one the
# Settings > Connected apps page says it is awaiting credentials. Both need TOKEN_ENCRYPTION_KEY, which encrypts the saved
# sign-in tokens: generate it once with `openssl rand -base64 32` and keep it safe (losing it means reconnecting calendars).
# Register this redirect address with the provider: <API_PUBLIC_URL>/api/v1/integrations/calendar/callback
# TOKEN_ENCRYPTION_KEY=
# API_PUBLIC_URL=http://localhost:4000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# Calendars sync by themselves about every 5 minutes, when the calendar is opened, and shortly after a change in AVEN.
# CALENDAR_SYNC_DISABLED=true turns the background run and automatic sends off on this server.
# CALENDAR_SYNC_DISABLED=false
