# Local AVEN web/API settings. Fill Clerk keys before using sign-in.
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Clerk development instance. Keep this file out of Git. The publishable key
# is public; never expose the secret key to browser code.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: set the PEM public key for networkless verification. If omitted, the API uses CLERK_SECRET_KEY.
CLERK_JWT_KEY=
CLERK_ISSUER=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Local PostgreSQL values for docker compose. Change these for shared environments.
POSTGRES_USER=aven
POSTGRES_PASSWORD=aven-local-only
POSTGRES_DB=aven
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aven:aven-local-only@localhost:5432/aven?schema=public

# File storage. Files are written under STORAGE_DIR (relative to where the API runs); only metadata is kept in PostgreSQL.
# STORAGE_DIR=.storage
# Use S3-compatible object storage instead of local disk:
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=   # only for non-AWS stores
# MAX_UPLOAD_BYTES=26214400
# WORKSPACE_STORAGE_QUOTA_BYTES=524288000

# AVEN Intelligence (model-backed assistant). Without a key the assistant stays off and the app says so.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_MONTHLY_CREDITS=2000
# AI_MAX_OUTPUT_TOKENS=2048
# Optional web search for the assistant (Brave Search API). Without a key the assistant answers from the workspace only.
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_BASE_URL=https://api.search.brave.com

# Workflows run inside the API process. Set WORKFLOWS_DISABLED=true on any instance that should not run them.
# WORKFLOWS_DISABLED=false
# Development only: lets webhooks call localhost. Refused when NODE_ENV=production.
# WORKFLOW_ALLOW_PRIVATE_WEBHOOKS=false

# Email (invitations and notification summaries). Without a key nothing is sent and the app says so.
# Uses Resend's HTTP API; EMAIL_FROM must be an address you have verified with the provider.
# EMAIL_API_KEY=
# EMAIL_FROM=AVEN <hello@your-domain.example>
# EMAIL_DISABLED=false

# Billing (Stripe Checkout + customer portal). Without keys everyone stays on the Free plan and the app says plans can't be changed.
# Create one recurring monthly price per plan in Stripe (A$9.99, A$19.99, A$29.99 per seat) and paste their ids.
# Point a Stripe webhook at POST <api>/api/v1/billing/webhook for: checkout.session.completed, customer.subscription.*, invoice.*
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PLUS=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
# Optional JSON to change plan limits without a code change, e.g. {"PLUS":{"limits":{"projects":40}}}
# BILLING_PLAN_OVERRIDES=

# Calendar sync (Google Calendar and Outlook). Each needs an OAuth app you create with the provider; without one the
# Settings > Connected apps page says it is awaiting credentials. Both need TOKEN_ENCRYPTION_KEY, which encrypts the saved
# sign-in tokens: generate it once with `openssl rand -base64 32` and keep it safe (losing it means reconnecting calendars).
# Register this redirect address with the provider: <API_PUBLIC_URL>/api/v1/integrations/calendar/callback
# TOKEN_ENCRYPTION_KEY=
# API_PUBLIC_URL=http://localhost:4000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# CALENDAR_SYNC_DISABLED=false
